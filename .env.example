# Copy this file to .env (gitignored — never commit real keys) and fill in
# whichever keys the sources you're running need. Loaded automatically by
# chckd_lists.config on import; no manual export/source step required.

# National Park Service API — sources/nps.py. Register at
# https://www.nps.gov/subjects/developer/get-started.htm
NPS_API_KEY=

# Protected Planet (WDPA) API — sources/protected_planet.py. Request one at
# https://api.protectedplanet.net/request
PROTECTED_PLANET_API_KEY=
